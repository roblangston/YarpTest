{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "static-route": {
        "ClusterId": "contact-cluster",
        "Match": {
          "Path": "/ui/blazortest/{**catchall}"
        },
        "Transforms": [
          {
            "PathPattern": "/{**catchall}"
          }
        ]
      },
      "static-route2": {
        "ClusterId": "contact-cluster",
        "Match": {
          "Path": "/blazor/{**catchall}"
        },
        "Transforms": [
          {
            "PathPattern": "/{**catchall}"
          }
        ]
      }
    },
    "Clusters": {
      "contact-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5165/blazor"
          }
        }
      }
    }
  }
}
